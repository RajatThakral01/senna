# ==============================================================================
# Viral Clips Automator - Environment Variables Template
# Copy this file to .env and configure your secrets:
#   cp .env.example .env
# ==============================================================================

# Groq API Credentials — used for LLM only (embeddings are local).
# Get your API keys from https://console.groq.com/keys and paste them below.
# Workload split (pipeline/llm_client.py): key1 = outline/discovery/enrich
# (~100K tokens/run), key2 = similarity (~35K), key3 = campaign/analyzer/
# boundaries (~35K), key4 = fallback whenever any slot key fails.
GROQ_API_KEY=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY_3=your_groq_api_key_3_here
GROQ_API_KEY_FALLBACK=your_groq_api_key_4_here

# ── Models ───────────────────────────────────────────────────────────────────
# LLM used for campaign parsing, viral analysis, and similarity classification.
# Must be a Groq-served id (see https://console.groq.com/docs/models),
# e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# Local embedding model (no API key needed). Local dir or HuggingFace id.
# Switch models without code changes, e.g. EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# NOTE: native dim (or EMBED_DIM truncation) must match db/schema.sql vector(N).
EMBED_MODEL=models/Qwen3-Embedding-0.6B
# Effective vector dimension (head-slice truncation for Matryoshka-capable models)
EMBED_DIM=1024
# Max tokens per text (longer inputs are truncated)
EMBED_MAX_SEQ=1024
# Device for embeddings: auto (CUDA if available, else CPU) | cuda | cpu
EMBED_DEVICE=auto
# Weight precision: auto (bfloat16 on CUDA, float32 on CPU) | bfloat16 | float16 | float32
EMBED_DTYPE=auto
# Batch size for bulk chunk embedding
EMBED_BATCH_SIZE=8

# Optional: override the OpenAI-compatible API base (default: Groq)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: transcription model (default small; see config.yaml [transcription])
# WHISPER_MODEL=small

# PostgreSQL + pgvector. Matches the Docker setup in README:
#   docker run -d --name viral-clips-db -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=viral_clips -p 5433:5432 pgvector/pgvector:pg16
# (5433 avoids clashing with a local Postgres already on 5432)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=viral_clips
DB_USER=postgres
DB_PASSWORD=postgres

# Optional: Path to custom ffmpeg binary (defaults to system 'ffmpeg' or config.yaml)
# FFMPEG_PATH=~/miniforge3/bin/ffmpeg

# Optional: Logging (overrides config.yaml [logging])
# LOG_LEVEL=INFO
# LOG_FILE=logs/viral-clips.log
# LOG_TO_CONSOLE=1
