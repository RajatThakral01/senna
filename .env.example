# ==============================================================================
# Viral Clips Automator - Environment Variables Template
# Copy this file to .env and configure your secrets:
#   cp .env.example .env
# ==============================================================================

# NVIDIA NIM API Credentials
# Required for LLM analysis (Kimi K2.6) and semantic embeddings (nv-embedqa-e5-v5).
# Get your API key from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# PostgreSQL Database Configuration (with pgvector extension)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=viral_clips
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Optional: Path to custom ffmpeg binary (defaults to system 'ffmpeg' or config.yaml)
# FFMPEG_PATH=~/miniforge3/bin/ffmpeg

# Optional: Logging (overrides config.yaml [logging])
# LOG_LEVEL=INFO
# LOG_FILE=logs/viral-clips.log
# LOG_TO_CONSOLE=1
