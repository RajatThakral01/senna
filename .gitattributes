# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.py text diff=python
*.sql text
*.yaml text
*.yml text
*.json text
*.md text
*.txt text
*.sh text eol=lf
*.css text

# Binary media assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.wav binary
*.mp3 binary
*.woff binary
*.woff2 binary
